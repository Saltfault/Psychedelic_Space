; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PsychedelicSpaceGame"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[asset_manager]

export_roots={
"effects": "res://assets/effects",
"images": "res://assets/sprites",
"music": "res://assets/audio/music",
"other": "res://assets",
"scenes": "res://scenes",
"shaders": "res://assets/shaders",
"sounds": "res://assets/audio/sfx"
}

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"
window/vsync/vsync_mode=0

[autoload]

Console="*uid://ouiu5xh1cs8n"
LitManager="*uid://brf2hvdtyyw3q"
RunState="*res://scenes/run_state.tscn"
GameSettings="*res://scripts/autoload/game_settings.gd"
DitherOverlay="*res://scenes/ui/dither_overlay.tscn"
SectorSpace="*uid://b8vh0l0qrnjlk"
DevConsoleCommands="*res://scenes/dev_console_commands.tscn"
SceneRouter="*res://scenes/scene_router.tscn"
Profily="*uid://qmnu1ehm866e"
Conductor="*uid://c5rvmkaorxynb"
EventAudio="*uid://be741v81fj3xc"
InputHelper="*uid://cholww48njaeh"
Juicee="*uid://b36fwfvmmv0xc"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/conductor/plugin.cfg", "res://addons/console/plugin.cfg", "res://addons/event_audio/plugin.cfg", "res://addons/global_asset_manager/plugin.cfg", "res://addons/godit/plugin.cfg", "res://addons/godoban/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/input_helper/plugin.cfg", "res://addons/inspector_tabs/plugin.cfg", "res://addons/juicee/plugin.cfg", "res://addons/licenses/plugin.cfg", "res://addons/lit/plugin.cfg", "res://addons/log/plugin.cfg", "res://addons/profily/plugin.cfg", "res://addons/project-time-tracker/plugin.cfg", "res://addons/quill-ide/plugin.cfg", "res://addons/terminal/plugin.cfg", "res://addons/yard/plugin.cfg", "res://addons/gdUnit4/plugin.cfg")

[gui]

theme/custom="res://assets/ui/scifi_ui/scifi_ui_theme.tres"

